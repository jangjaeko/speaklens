<% content_for :title, "Recordings" %>

<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl">Recordings</h1>
    <%= link_to "New recording", new_recording_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @recordings.any? %>
    <ul class="mt-8 divide-y divide-gray-200">
      <% @recordings.each do |recording| %>
        <li class="py-3 flex items-center justify-between">
          <%= link_to l(recording.created_at, format: :long), recording, class: "underline hover:no-underline" %>
          <span class="text-sm text-gray-500"><%= recording.status.humanize %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-8 text-gray-500">No recordings yet.</p>
  <% end %>

  <%= button_to "Sign out", session_path, method: :delete, class: "mt-12 text-sm text-gray-500 underline hover:no-underline cursor-pointer" %>
</div>
