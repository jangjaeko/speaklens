<section id="speaker_picker" class="mt-8 p-4 rounded-lg bg-blue-50">
  <h2 class="font-bold text-xl">Which speaker are you?</h2>
  <p class="mt-1 text-sm text-gray-600">Only your speech is analyzed. Pick the speaker whose lines are yours.</p>

  <ul class="mt-4 space-y-3">
    <% recording.speakers.each do |speaker| %>
      <% sample = recording.utterances.find { |utterance| utterance.speaker == speaker } %>
      <li class="flex items-center justify-between gap-4">
        <div>
          <span class="font-medium"><%= sample.speaker_name %></span>
          <p class="text-sm text-gray-600">“<%= sample.text.truncate(80) %>”</p>
        </div>
        <%= button_to "This is me", recording_speaker_path(recording), method: :patch, params: { speaker: speaker },
              class: "shrink-0 rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      </li>
    <% end %>
  </ul>
</section>
