<% content_for :title, "Recording" %>

<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/flash" %>

  <h1 class="font-bold text-4xl">Recording</h1>
  <p class="mt-2 text-gray-500"><%= l(@recording.created_at, format: :long) %></p>

  <dl class="mt-6 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
    <dt class="font-medium">Status</dt>
    <dd id="recording_status"><%= @recording.status.humanize %></dd>

    <% if @recording.failed? %>
      <dt class="font-medium">Error</dt>
      <dd class="text-red-500"><%= @recording.error_message %></dd>
    <% end %>

    <dt class="font-medium">Delete audio after transcription</dt>
    <dd><%= @recording.delete_audio_after_transcription? ? "Yes" : "No" %></dd>

    <dt class="font-medium">Keep only my speech</dt>
    <dd><%= @recording.discard_others_utterances? ? "Yes" : "No" %></dd>
  </dl>

  <% if @recording.audio.attached? %>
    <audio controls src="<%= url_for(@recording.audio) %>" class="mt-6 w-full"></audio>
  <% end %>

  <%= link_to "Back to recordings", recordings_path, class: "inline-block mt-8 text-gray-700 underline hover:no-underline" %>
</div>
